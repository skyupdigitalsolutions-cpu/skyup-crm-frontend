# Cloudflare Pages edge headers — ISO/IEC 27001:2022 A.8.9 / A.8.26
# The backend's `helmet` config only covers API responses. Anything served
# directly by Cloudflare Pages (this SPA's HTML/JS/CSS) needs its own headers.
#
# CSP is deliberately left OFF here for now — this SPA loads Google Fonts,
# Socket.IO, and an inline theme-flash script in index.html. Turn CSP on only
# after testing with the real production build (npm run preview), matching
# the same opt-in caution the backend applies via ENABLE_CSP.

# geolocation=(self): clock-in location (CRM ClockInGate / AttendancePage and the
# /agent app) needs the browser's location API on this site only. It stays blocked
# for third-party frames. Previously geolocation=() blocked it everywhere.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ── Caching — prevents the "stale deploy" chunk errors ────────────────────────
# index.html must always be revalidated, so after a deploy browsers get the new
# file names instead of requesting old /assets files that no longer exist.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Hashed build files never change content under the same name — cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Finance Panel PWA ─────────────────────────────────────────────────────────
# The service worker file must be revalidated on every load so updates reach users.
/finance-sw.js
  Cache-Control: no-cache
/finance-manifest.json
  Cache-Control: public, max-age=3600
/finance-offline.html
  Cache-Control: no-cache
/finance-icons/*
  Cache-Control: public, max-age=604800

# ── Agent app PWA (/agent) ────────────────────────────────────────────────────
/agent-sw.js
  Cache-Control: no-cache
/agent-manifest.json
  Cache-Control: public, max-age=3600
/agent-offline.html
  Cache-Control: no-cache
/agent-icons/*
  Cache-Control: public, max-age=604800
